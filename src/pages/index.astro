<Layout>
</Layout>

<style>
/* Grid til de 4 kaffekarakterer */
/* .kaffe-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr); 
  margin-top: 28px;
} */
 
.kaffe-grid {
  display: grid;
  /* Giver hver kolonne en fast max-bredde, og fordeler pladsen imellem dem automatisk */
  grid-template-columns: repeat(4, auto);
  justify-content: space-between; /* Skubber dem ud til hver sin kant af sektionen */
  gap: 28px;
  margin-top: 28px;
}
.kaffe-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.kaffe-item img {
  width: 100%;
  max-width: 140px; /* Styrer størrelsen på billederne */
  height: auto;
  object-fit: contain;
}

.voresKaffeTekst{
	max-width: 500px;
}

.voresKaffeTekst,
.voresKaffe{
	display: flex;
	flex-direction: column;
	gap: 28px;
	
}
.voresKaffe{
	background-color: var(--seashell-300);
	margin: 160px 100px; /* 160px mellemrummet mellem hero og første sektion. 100px er i stedet for max-width  */
	padding: 68px 68px;
	border-radius: 4px;
}

.h4Grøn {
	color: var(--green-500);
}
/* Responsivt til mindre skærme */
@media (max-width: 1100px) {
  .kaffe-grid {
    grid-template-columns: repeat(2, 1fr); /* 2x2 kolonner på tablets */
  }
}

@media (max-width: 600px) {
  .kaffe-grid {
    grid-template-columns: 1fr; /* 1 kolonne på mobilen */
  }
  .voresKaffe {
    margin: 20px;
    padding: 20px;
  }
}
/* Knappen "SE LOKATIONER" */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border-radius: 4px;
  padding: 0.85rem 1.75rem;
  border: 2px solid var(--orange-500);
  background-color: #D8AD96; 
  color: var(--orange-500); 
  border-radius: 4px;
  text-decoration: none;
  transition: all 0.25s ease;
}

/* Skjul ikonet som standard, hvis det kun skal vises ved hover */
.btn .btn-icon {
  width: 16px;
  height: auto;
  color: var(--coffeebean-500);
  display: none;
}

.btn:hover {
	background-color: #322b2455; 
  color:var(--coffeebean-500); /* Mørkbrun tekstfarve */
  border-color: var(--coffeebean-500); /* Mørkbrun kant hele vejen rundt */
  transition: all 0.3s ease;
}

/* Vis kaffebønne-ikonet når der hovres */
.btn:hover .btn-icon {
  display: inline-block;
}

.hero {
  display: grid;
  grid-template-columns: 1fr 1fr; /* Deler sektionen i to lige store kolonner */
  min-height: 80vh; /* Giver sektionen en god højde */
  align-items: center; /* Centrerer indholdet vertikalt */
  position: relative;
  overflow: hidden; /* Skjuler evt. dekorationer der stikker ud over kanten */
}

/* Venstre side: Tekst og knap */
.hero-content {
	display: flex;
	flex-direction: column;
	align-items: flex-start; 
  padding: 80px 100px;
  gap: 28px;
  max-width: 750px;
}

/* Højre side: Billedet */
.hero-image {
  height: 100%;
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover; 
  display: block;
}

/* Responsivt design til mobil */
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr; /* Lægger tekst og billede under hinanden på små skærme */
  }
  
  .hero-content {
    padding: 20px;
	padding-bottom: 68px;
  }
  
  .hero-image {
    padding: 0;
    order: -1; /* Flytter billedet op over teksten */
  }
}

/* HEADER - MOBIL */

.header {
  width: 100%;
  padding: 20px;
background-color: var(--seashell-300);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid var(--coffeebean-500);
  position: relative;
}

.logo img {
  width: 150px;
  height: auto;
  display: block;
}

/* BURGERMENU */

.menu-toggle {
  background: none;
  border: none;
  cursor: pointer;

  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px;
}

.menu-toggle span {
  width: 28px;
  height: 2px;
  background-color: var(--coffeebean-500);
  display: block;
}

/* NAVIGATION - MOBIL */

.navigation {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background-color: var(--seashell-300);
  padding: 20px 6%;
  flex-direction: column;
  gap: 25px;
  z-index: 10;
}

.navigation a {
  text-decoration: none;
  color: var(--coffeebean-500);
  font-size: 18px;
  font-weight: 600;
}
.navigation a:hover {
  color: var(--orange-500);
}

/* MENU ÅBEN */

.navigation.active {
  display: flex;
}

/* DESKTOP MENU */

@media (min-width: 900px) {
  .header {
    min-height: 150px;
    padding: 15px 100px;
  }

  .logo img {
    width: 250px;
  }

  .menu-toggle {
    display: none;
  }

  .navigation {
    display: flex;
    position: static;
    width: auto;
    padding: 0;

    flex-direction: row;
    align-items: center;
    gap: 30px;
  }

  .navigation a {
    font-size: 16px;
	font-weight: 600;
  }
}

body {
  background-color: var(--seashell-500);
}
</style>